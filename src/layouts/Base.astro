---
import '@fontsource-variable/bitter/wght.css';
import '../styles/global.css';
import bodyFont from '@fontsource-variable/bitter/files/bitter-cyrillic-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import { withBase } from '../lib/url';
import { site } from '../data/club';
import { JS_FLAG } from '../lib/js-flag.mjs';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('/og.jpg'), Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#e8dccb" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline set:html={JS_FLAG} />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="after" />
  </body>
</html>

<style is:global>
  main:focus { outline: none; }
</style>

<script>
  import { animate } from 'motion/mini';
  import { EASE, prefersReducedMotion } from '../lib/motion';

  // Section entrances: the parts of a block rise in turn the first time it comes into view.
  const blocks = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const showAll = (block: Element) => [...block.children].forEach((p) => ((p as HTMLElement).style.opacity = '1'));
  const show = (block: HTMLElement) => {
    if (prefersReducedMotion()) return showAll(block);
    [...block.children].forEach((p, i) =>
      animate(p, { opacity: [0, 1], transform: ['translateY(24px)', 'translateY(0)'] }, { duration: 0.7, delay: i * 0.08, ease: EASE }),
    );
  };
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        show(e.target as HTMLElement);
      }),
    { rootMargin: '0px 0px -12% 0px' },
  );
  blocks.forEach((b) => io.observe(b));
  addEventListener('beforeprint', () => blocks.forEach(showAll));

  // Torn paper edges (src/lib/zigzag.ts): a generated clip-path cannot live in a class, and the CSP blocks inline styles.
  document.querySelectorAll<HTMLElement>('[data-clip]').forEach((el) => (el.style.clipPath = el.dataset.clip!));
</script>

---
import { withBase } from '../../lib/url';
import { rub, site, zones } from '../../data/club';

const title = 'Своя лампа над каждым местом';
const words = title.split(' ');
const hall = zones[0]!;
---

<section class="hero" data-scene="plan" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero__title">
    {words.map((w, i) => <><span class:list={['w', `w${i}`]}>{w}</span>{i < words.length - 1 ? ' ' : ''}</>)}
  </h1>
  <p class="hero__lead lead">
    Компьютерный клуб-лаунж у Китай-города: 25 мощных компьютеров, буткемп для команды и две комнаты с PlayStation&nbsp;5&nbsp;Pro.
    Тёплый свет вместо неона, открыто круглосуточно.
  </p>
  <dl class="hero__facts">
    <div><dt>Днём в будни</dt><dd>{rub(hall.day)} в час</dd></div>
    <div><dt>Вечером и в выходные</dt><dd>{rub(hall.evening)} в час</dd></div>
    <div><dt>От метро</dt><dd>6 минут</dd></div>
  </dl>
  <div class="hero__actions">
    <a class="btn" href={withBase('/#bron')}>Выбрать место</a>
    <a class="btn btn--quiet" href={withBase('/#ceny')}>Все цены</a>
  </div>
  <p class="hero__where small muted">{site.address.street}, {site.address.metro}.</p>
</section>

<style>
  .hero {
    display: flex; flex-direction: column; justify-content: center; gap: 1.75rem;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(3rem, 10svh, 7rem) 3rem;
  }
  .hero__title { font-size: var(--step-display); max-width: 15ch; }
  .hero__lead { max-width: 34ch; }
  .hero__facts { display: flex; flex-wrap: wrap; gap: 1.25rem 2.5rem; }
  .hero__facts dt { font-size: var(--step-small); color: var(--fg-2); }
  .hero__facts dd { font-size: var(--step-lead); font-weight: 600; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  @media (prefers-reduced-motion: no-preference) {
    .w { display: inline-block; animation: rise 1s var(--ease) both; }
    .w1 { animation-delay: 0.08s; }
    .w2 { animation-delay: 0.16s; }
    .w3 { animation-delay: 0.24s; }
    .w4 { animation-delay: 0.32s; }
    .hero__lead, .hero__facts, .hero__actions, .hero__where { animation: rise 0.9s var(--ease) both; }
    .hero__lead { animation-delay: 0.45s; }
    .hero__facts { animation-delay: 0.55s; }
    .hero__actions { animation-delay: 0.65s; }
    .hero__where { animation-delay: 0.75s; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(0.5em); }
  }

  @media (max-width: 960px) {
    .hero { min-height: 0; padding-block: 2.5rem 4rem; gap: 1.5rem; }
    .hero__actions .btn { flex: 1 1 10rem; }
  }
</style>

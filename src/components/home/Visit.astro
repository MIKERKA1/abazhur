---
// Contacts as a visit card laid on the street outside: cold snow behind, a warm card in front.
import { Picture } from 'astro:assets';
import { withBase } from '../../lib/url';
import { site } from '../../data/club';
import { photos } from '../../data/photos';
---

<section id="kontakty" class="contact" aria-labelledby="kontakty-title">
  <Picture src={photos.street.src} alt={photos.street.alt} formats={['avif', 'webp']} widths={[720, 1200]} sizes="100vw" loading="lazy" class="contact__photo" />
  <div class="card" data-reveal>
    <h2 id="kontakty-title" class="card__title">Как нас найти</h2>
    <address class="card__address">
      {site.address.city}, {site.address.street}<br />
      {site.address.metro}. Вход со двора, над дверью висит абажур.
    </address>
    <dl class="card__hours">
      {site.hours.map(([what, time]) => <div><dt>{what}</dt><dd>{time}</dd></div>)}
    </dl>
    <p class="card__contacts">
      <a href={site.phone.href}>{site.phone.display}</a><br />
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p class="small muted">Адрес, телефон и почта вымышленные: это демо-проект.</p>
    <a class="btn card__cta" href={withBase('/#bron')}>Забронировать место</a>
  </div>
</section>

<style>
  .contact { position: relative; min-height: 100svh; display: grid; justify-items: end; align-items: start; padding: 4rem var(--gutter); }
  .contact :global(.contact__photo), .contact :global(.contact__photo img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card { position: relative; display: grid; gap: 1.25rem; width: min(100%, 26rem); padding: 2rem 2rem 0; background: var(--paper); }
  .card__title { font-size: var(--step-lead); font-weight: 500; }
  .card__address { font-style: normal; }
  .card__hours div { display: flex; justify-content: space-between; gap: 1rem; }
  .card__hours dd { font-weight: 600; text-align: right; }
  .card__contacts a { font-weight: 600; }
  .card__cta { margin: 0.5rem -2rem 0; min-height: 3.5rem; }

  @media (max-width: 960px) {
    .contact { min-height: 0; padding: 70svh 0.75rem 0; justify-items: stretch; }
    .contact :global(.contact__photo), .contact :global(.contact__photo img) { height: 70svh; }
    .card { width: auto; margin-top: -5rem; padding: 1.5rem 1.25rem 0; }
    .card__cta { margin-inline: -1.25rem; }
  }
</style>
